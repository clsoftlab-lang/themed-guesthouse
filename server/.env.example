#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 제외되어 있습니다).
# ⚠️ API 키는 오직 이 백엔드에서만 사용합니다. 브라우저/프론트엔드에 절대 넣지 마세요.

# Anthropic API 키 (콘솔에서 발급). 실제 키로 교체하세요.
ANTHROPIC_API_KEY=replace_with_your_real_key

# 모델 (비용 우선 기본값). 품질이 필요하면 claude-sonnet-5 / claude-opus-5 로 상향.
AI_MODEL=claude-haiku-4-5

# 비-Haiku 모델의 effort (기본 low). Haiku 4.5 에서는 무시됨.
AI_EFFORT=low

# 월 토큰 예산 (초과 시 429 {fallback:true} → 프론트가 mock 으로 폴백)
AI_MONTHLY_TOKEN_CAP=2000000

# IP 당 분당 요청 제한
AI_RATE_LIMIT=20

# 프록시 포트 (기본 8787)
PORT=8787

# 허용할 프론트엔드 오리진 (기본 * ; 운영 시엔 실제 도메인으로 제한 권장)
CORS_ORIGIN=*
