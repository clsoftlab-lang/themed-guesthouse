#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 제외되어 있습니다).
# ⚠️ API 키는 오직 이 백엔드에서만 사용합니다. 브라우저/프론트엔드에 절대 넣지 마세요.

# Anthropic API 키 (콘솔에서 발급). 실제 키로 교체하세요.
ANTHROPIC_API_KEY=replace_with_your_real_key

# 프록시 포트 (기본 8787)
PORT=8787

# 허용할 프론트엔드 오리진 (기본 * ; 운영 시엔 실제 도메인으로 제한 권장)
CORS_ORIGIN=*
